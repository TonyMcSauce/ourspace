rules_version = '2';

// Only the two of you can read or write anything.
// Replace the two emails below with the exact emails of your Firebase
// Authentication accounts (the same ones you put in js/config.js),
// then paste this whole file into Firebase console > Firestore > Rules
// and press Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function isUs() {
      return request.auth != null
        && request.auth.token.email.lower() in [
          'TONY_EMAIL_HERE',
          'BABEGIRL_EMAIL_HERE'
        ];
    }

    match /spaces/{spaceId}/{document=**} {
      allow read, write: if isUs();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
